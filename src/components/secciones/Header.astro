---
import { tiendaConfig } from '../../config/tienda';
---
<header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-[var(--color-borde)]">
  <div class="max-w-6xl mx-auto px-4 h-15 flex items-center justify-between">
    <!-- Logo ViralyShop -->
    <a href="/" class="flex items-center gap-2 group" aria-label="Inicio ViralyShop">
      <div class="w-8 h-8 rounded-xl bg-[var(--color-grafito)] flex items-center justify-center text-white font-black text-base shadow-xs group-hover:bg-[var(--color-teal)] transition-colors">
        V
      </div>
      <div class="flex flex-col">
        <span class="font-black text-lg tracking-tight text-[var(--color-tinta)] leading-none">
          {tiendaConfig.nombreTienda}
        </span>
        <span class="text-[9px] font-bold tracking-widest text-[var(--color-teal)] uppercase">
          Deportes & Soporte
        </span>
      </div>
    </a>

    <!-- Botón directo de contacto / scroll a pedido -->
    <a
      href="#pedido"
      class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-[var(--color-niebla)] hover:bg-gray-200 border border-[var(--color-borde)] text-[var(--color-tinta)] font-bold text-xs transition-colors cursor-pointer"
      aria-label="Ir al formulario de pedido contraentrega"
    >
      <svg class="w-4 h-4 text-[var(--color-teal)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
      </svg>
      <span class="hidden sm:inline">Pide Contraentrega</span>
      <span class="sm:hidden">Pedir</span>
    </a>
  </div>
</header>
