---
import { getCollection } from 'astro:content';
import { tiendaConfig } from '../../config/tienda';

const faqs = (await getCollection('faqs')).sort((a, b) => a.data.orden - b.data.orden);

// JSON-LD FAQPage Schema
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.data.pregunta,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.data.respuesta,
    },
  })),
};
---
<section id="faq" class="py-16 md:py-20 bg-[var(--color-niebla)] section-animate">
  <div class="max-w-4xl mx-auto px-4">
    <div class="text-center max-w-xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-teal)] bg-sky-50 border border-sky-200 px-3 py-1 rounded-full">
        Preguntas Frecuentes
      </span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--color-tinta)] mt-3">
        Resolvemos tus dudas
      </h2>
      <p class="text-sm md:text-base text-[var(--color-gris)] mt-2">
        Todo lo que necesitas saber sobre envíos, tallas y modo de uso.
      </p>
    </div>

    {/* Acordeón accesible sin JavaScript mediante <details> nativos */}
    <div class="space-y-3.5">
      {faqs.map((faq) => (
        <details class="group bg-white rounded-2xl border border-[var(--color-borde)] p-5 transition-all shadow-xs open:ring-1 open:ring-[var(--color-teal)]/30">
          <summary class="flex items-center justify-between font-bold text-sm sm:text-base text-[var(--color-tinta)] cursor-pointer select-none list-none outline-none">
            <span>{faq.data.pregunta}</span>
            <span class="w-7 h-7 rounded-full bg-[var(--color-niebla)] group-open:bg-sky-100 group-open:text-[var(--color-teal)] flex items-center justify-center shrink-0 ml-3 transition-transform group-open:rotate-180">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path d="M6 9l6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </summary>
          <div class="mt-3.5 pt-3.5 border-t border-[var(--color-borde)] text-xs sm:text-sm text-[var(--color-gris)] leading-relaxed">
            {faq.data.respuesta}
          </div>
        </details>
      ))}
    </div>

    {/* Aviso obligatorio visible en la FAQ */}
    <div class="mt-10 bg-white rounded-2xl p-5 border border-sky-200 shadow-xs flex items-start gap-3.5">
      <div class="w-8 h-8 rounded-full bg-sky-100 text-[var(--color-teal)] flex items-center justify-center shrink-0 mt-0.5">
        <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"/>
          <line x1="12" y1="16" x2="12" y2="12"/>
          <line x1="12" y1="8" x2="12.01" y2="8"/>
        </svg>
      </div>
      <div>
        <h3 class="text-xs font-bold uppercase tracking-wider text-[var(--color-teal)]">
          Aviso sobre salud y deporte:
        </h3>
        <p class="text-xs text-[var(--color-gris)] mt-1 leading-relaxed">
          {tiendaConfig.avisoLegalSalud}
        </p>
      </div>
    </div>
  </div>
</section>

{/* JSON-LD FAQPage */}
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
