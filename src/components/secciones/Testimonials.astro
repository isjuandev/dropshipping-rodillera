---
import { getCollection } from 'astro:content';

const testimonios = await getCollection('testimonios');

const ratingBars = [
  { estrellas: 5, porcentaje: 88, cantidad: 2059 },
  { estrellas: 4, porcentaje: 10, cantidad: 234 },
  { estrellas: 3, porcentaje: 2, cantidad: 47 },
  { estrellas: 2, porcentaje: 0, cantidad: 0 },
  { estrellas: 1, porcentaje: 0, cantidad: 0 },
];
---
<section class="py-16 md:py-20 bg-white section-animate">
  <div class="max-w-6xl mx-auto px-4">
    <div class="text-center max-w-xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-wider text-[var(--color-teal)] bg-sky-50 border border-sky-200 px-3 py-1 rounded-full">
        Opiniones Reales
      </span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-[var(--color-tinta)] mt-3">
        La experiencia de quienes ya la usan
      </h2>
      <p class="text-sm md:text-base text-[var(--color-gris)] mt-2">
        Comentarios de clientes verificados que entrenan y trabajan con FlexiKnee en Colombia.
      </p>
    </div>

    {/* Resumen 4,8 de 5 con barras */}
    <div class="bg-[var(--color-niebla)] rounded-3xl p-6 md:p-8 border border-[var(--color-borde)] mb-12 max-w-3xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
        {/* Puntuación General */}
        <div class="md:col-span-5 text-center md:text-left md:border-r md:border-[var(--color-borde)] md:pr-6">
          <span class="text-5xl md:text-6xl font-black text-[var(--color-tinta)] tabular-nums">4,8</span>
          <div class="flex items-center justify-center md:justify-start text-amber-500 my-2">
            {Array.from({ length: 5 }).map((_) => (
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
          </div>
          <p class="text-xs font-semibold text-[var(--color-gris)]">Basado en 2.340 calificaciones verificadas</p>
          <div class="inline-flex items-center gap-1.5 text-xs text-[var(--color-exito)] font-bold mt-2 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200">
            <span>✓ 98 % de recomendación</span>
          </div>
        </div>

        {/* Barras de distribución por estrellas */}
        <div class="md:col-span-7 space-y-2">
          {ratingBars.map((bar) => (
            <div class="flex items-center gap-3 text-xs">
              <span class="w-12 font-bold text-[var(--color-gris)]">{bar.estrellas} estrellas</span>
              <div class="flex-1 h-2.5 bg-gray-200 rounded-full overflow-hidden">
                <div
                  class="h-full bg-amber-400 rounded-full"
                  style={`width: ${bar.porcentaje}%`}
                />
              </div>
              <span class="w-10 text-right font-medium text-[var(--color-gris)] tabular-nums">
                {bar.porcentaje}%
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* Rejilla de 6 Reseñas */}
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {testimonios.map((item) => (
        <div class="bg-white rounded-2xl p-6 border border-[var(--color-borde)] shadow-xs flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            {/* Header de Reseña */}
            <div class="flex items-center gap-3 mb-3">
              <img
                src={item.data.foto}
                alt={item.data.nombre}
                width={48}
                height={48}
                loading="lazy"
                class="w-12 h-12 rounded-full object-cover border border-[var(--color-borde)] shrink-0"
              />
              <div>
                <h3 class="font-bold text-sm text-[var(--color-tinta)] leading-tight">{item.data.nombre}</h3>
                <p class="text-xs text-[var(--color-gris)]">{item.data.ciudad}</p>
                <span class="inline-block text-[10px] text-[var(--color-teal)] font-semibold">
                  Actividad: {item.data.actividad}
                </span>
              </div>
            </div>

            {/* Estrellas */}
            <div class="flex items-center text-amber-500 mb-2.5">
              {Array.from({ length: item.data.estrellas }).map((_) => (
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                </svg>
              ))}
            </div>

            {/* Texto de testimonio */}
            <p class="text-xs sm:text-sm text-[var(--color-gris)] leading-relaxed italic">
              "{item.data.texto}"
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-[var(--color-borde)] flex items-center gap-1.5 text-[11px] text-[var(--color-exito)] font-semibold">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            Comprador verificado contraentrega
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
