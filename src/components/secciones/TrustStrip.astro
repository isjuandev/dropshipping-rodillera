---
const items = [
  {
    icon: `<svg class="w-6 h-6 text-[var(--color-teal)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
    title: 'Pago contraentrega',
    subtitle: 'Pagas en efectivo al recibir en mano',
  },
  {
    icon: `<svg class="w-6 h-6 text-[var(--color-teal)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>`,
    title: 'Envío 2 a 5 días',
    subtitle: 'Despacho rápido a toda Colombia',
  },
  {
    icon: `<svg class="w-6 h-6 text-[var(--color-teal)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38l5.67-5.67"/></svg>`,
    title: 'Cambio de talla gratis',
    subtitle: 'Si no te queda, te la cambiamos sin costo',
  },
  {
    icon: `<svg class="w-6 h-6 text-[var(--color-teal)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>`,
    title: '+8.000 rodilleras enviadas',
    subtitle: 'Clientes activos en los 32 departamentos',
  },
];
---
<section class="border-y border-[var(--color-borde)] bg-[var(--color-niebla)] py-6">
  <div class="max-w-6xl mx-auto px-4">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {items.map((item) => (
        <div class="flex items-center gap-3 bg-white p-3.5 sm:p-4 rounded-2xl border border-[var(--color-borde)] shadow-xs">
          <div class="shrink-0 p-2 rounded-xl bg-sky-50" set:html={item.icon} />
          <div>
            <h4 class="font-bold text-xs sm:text-sm text-[var(--color-tinta)] leading-tight">{item.title}</h4>
            <p class="text-[10px] sm:text-xs text-[var(--color-gris)] mt-0.5 line-clamp-1">{item.subtitle}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
